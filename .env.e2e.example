# Copy this file to .env.e2e.local and fill it in. That copy is gitignored (see .gitignore);
# this one is not.
#
# A test account that exists ONLY in the local Supabase stack (127.0.0.1), never on prod.
# Make it through the normal "Create an account" form on http://localhost:3000. Email
# confirmation is off locally, so it works straight away.
E2E_EMAIL=tester@wander.test
E2E_PASSWORD=pick-a-throwaway-password
# The id of a trip that account owns (the address bar shows it: /trips/<this>/itinerary).
E2E_TRIP_ID=00000000-0000-0000-0000-000000000000
